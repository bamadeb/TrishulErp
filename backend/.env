# Local settings for development. This file is git-ignored: never commit it.
# In AWS, set these as ECS task environment variables, with the password from Secrets Manager.

TRISHUL_ENVIRONMENT=dev

# Amazon RDS for SQL Server
# Use a least-privilege application login, not the RDS master user.
# Login with DDL rights, used only by `alembic upgrade`

# Sign-in: "cognito" (normal) or "dev" (local only: every request acts as TRISHUL_DEV_USERNAME)
TRISHUL_AUTH_MODE=cognito
TRISHUL_DEV_USERNAME=demo.admin

TRISHUL_CORS_ORIGINS=["http://localhost:4200"]
TRISHUL_AWS_PROFILE=trishul

# --- AWS Secrets Manager (leave empty for local dev; the DB_USER/DB_PASSWORD above are used) ---
# In AWS, set these instead of TRISHUL_DB_PASSWORD.   See docs/Trishul_Secrets_Manager.md.
TRISHUL_DB_SECRET_ID=trishul/dev/db-app
TRISHUL_MIGRATION_DB_SECRET_ID=trishul/dev/db-migration
# TRISHUL_SECRETS_REGION=us-east-1 
# TRISHUL_SECRETS_CACHE_SECONDS=300
TRISHUL_SECRETS_REGION=us-east-1
TRISHUL_COGNITO_SECRET_ID=trishul/dev/cognito
